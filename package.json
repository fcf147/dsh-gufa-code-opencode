{
  "name": "dsh-gufa-code-opencode",
  "version": "1.3.215-codebuddy.1",
  "description": "古法编程 + opencode 后端：DSH 主面板变身 VS Code 风格 IDE（Monaco、文件树、Git、SSH、真实终端），AI 面板可在 DSH / opencode 之间运行时切换（fork 自 dsh-gufa-code，MIT）",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "ide",
    "vscode",
    "monaco",
    "cursor",
    "ai",
    "terminal",
    "git",
    "opencode",
    "acp",
    "agent-backend"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "vendor",
    "src",
    "scripts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "screenshots.json",
    "desktop"
  ],
  "dependencies": {
    "eslint": "^8.57.1",
    "pyright": "^1.1.414",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": {
    "name": "Jeff nan (upstream dsh-gufa-code)",
    "url": "https://github.com/liujiangnanchenjbguo/dsh-gufa-code"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcf147/dsh-gufa-code-opencode.git"
  },
  "homepage": "https://github.com/fcf147/dsh-gufa-code-opencode#readme",
  "bugs": {
    "url": "https://github.com/fcf147/dsh-gufa-code-opencode/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/selftest-client.mjs && node scripts/selftest-host.mjs && node scripts/test-editor.mjs && node --test scripts/test-domain-event.mjs scripts/test-transition-parity.mjs scripts/test-opencode.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:float:macos": "./scripts/build-float-macos.sh",
    "build:float:linux": "./scripts/build-float-linux.sh",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "test:codebuddy": "node --test scripts/test-domain-event.mjs scripts/test-transition-parity.mjs scripts/test-opencode.mjs",
    "verify:endpoint": "node scripts/verify-stream-endpoint.mjs",
    "verify:context": "node scripts/verify-stream-context.mjs"
  },
  "contributors": [
    {
      "name": "fcf147",
      "url": "https://github.com/fcf147"
    }
  ]
}
